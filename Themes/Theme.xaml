<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== COLOR PALETTE ==================== -->
    <Color x:Key="BgDarkColor">#090A0E</Color>
    <Color x:Key="TextPrimaryColor">#F2F4F7</Color>
    <Color x:Key="TextSecondaryColor">#949BA8</Color>
    <Color x:Key="TextMutedColor">#5C6370</Color>

    <Color x:Key="BlurpleColor">#5865F2</Color>
    <Color x:Key="BlurpleLightColor">#727DFF</Color>
    <Color x:Key="BlurpleHoverColor">#4752C4</Color>
    <Color x:Key="BlurplePressedColor">#3842A6</Color>

    <Color x:Key="OnlineGreenColor">#23A55A</Color>
    <Color x:Key="OnlineGreenGlowColor">#34C759</Color>

    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BlurpleBrush" Color="{StaticResource BlurpleColor}" />
    <SolidColorBrush x:Key="BlurpleLightBrush" Color="{StaticResource BlurpleLightColor}" />
    <SolidColorBrush x:Key="BlurpleHoverBrush" Color="{StaticResource BlurpleHoverColor}" />
    <SolidColorBrush x:Key="OnlineGreenBrush" Color="{StaticResource OnlineGreenColor}" />

    <!-- ==================== LIQUID GLASS BRUSHES ==================== -->
    <!-- Window Ambient Background (Subtle radial glow behind dark obsidian glass) -->
    <RadialGradientBrush x:Key="WindowAmbientBgBrush" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.9" RadiusY="0.7">
        <GradientStop Color="#161A28" Offset="0" />
        <GradientStop Color="#0D0F15" Offset="0.5" />
        <GradientStop Color="#090A0E" Offset="1" />
    </RadialGradientBrush>

    <!-- Card Glass Fill (Translucent liquid glass with top sheen) -->
    <LinearGradientBrush x:Key="GlassCardBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141724" Offset="0" />
        <GradientStop Color="#0F111B" Offset="0.5" />
        <GradientStop Color="#0A0B10" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass Specular Border (Top edge catches the light vividly) -->
    <LinearGradientBrush x:Key="GlassCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3E4862" Offset="0" />
        <GradientStop Color="#212636" Offset="0.35" />
        <GradientStop Color="#131620" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass Refraction Inner Highlight (Top shine line inside rounded cards) -->
    <LinearGradientBrush x:Key="GlassInnerHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.25" />
        <GradientStop Color="#22FFFFFF" Offset="0.75" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero Card Fill (Discord Rich Presence Live Card) -->
    <LinearGradientBrush x:Key="GlassInnerBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171A27" Offset="0" />
        <GradientStop Color="#10131E" Offset="0.5" />
        <GradientStop Color="#090B10" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassInnerBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4E5A7B" Offset="0" />
        <GradientStop Color="#283044" Offset="0.5" />
        <GradientStop Color="#141722" Offset="1" />
    </LinearGradientBrush>

    <!-- Control Surface Fill -->
    <LinearGradientBrush x:Key="GlassControlBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B202D" Offset="0" />
        <GradientStop Color="#11141D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassControlHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#252C3E" Offset="0" />
        <GradientStop Color="#171C28" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassControlBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#384258" Offset="0" />
        <GradientStop Color="#1F2432" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassControlHoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#556384" Offset="0" />
        <GradientStop Color="#323C50" Offset="1" />
    </LinearGradientBrush>

    <!-- Primary Blurple Glass Button Brush -->
    <LinearGradientBrush x:Key="GlassPrimaryBtnBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5F6DFF" Offset="0" />
        <GradientStop Color="#4754E8" Offset="0.6" />
        <GradientStop Color="#3B46C9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPrimaryBtnHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6E7BFF" Offset="0" />
        <GradientStop Color="#5361F2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPrimaryBtnBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#97A2FF" Offset="0" />
        <GradientStop Color="#5360EE" Offset="1" />
    </LinearGradientBrush>

    <!-- Subtle Divider Line -->
    <LinearGradientBrush x:Key="GlassDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#002D3446" Offset="0" />
        <GradientStop Color="#323B4E" Offset="0.5" />
        <GradientStop Color="#002D3446" Offset="1" />
    </LinearGradientBrush>

    <!-- Progress Bar Gradient (Glowing Blurple Track) -->
    <LinearGradientBrush x:Key="GlassProgressBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5865F2" Offset="0" />
        <GradientStop Color="#8591FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Knob Gradient -->
    <LinearGradientBrush x:Key="KnobBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E6EAF2" Offset="1" />
    </LinearGradientBrush>

    <!-- ==================== METRICS & CORNERS ==================== -->
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="InnerCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, sans-serif</FontFamily>

    <!-- ==================== EASING ==================== -->
    <CubicEase x:Key="SmoothEase" EasingMode="EaseOut" />

    <!-- ==================== VECTOR SVG GEOMETRIES (24x24 Feather/Lucide) ==================== -->
    <!-- Sliders / Equalizer icon (for Status Settings) -->
    <Geometry x:Key="IconSlidersGeo">M 4,21 L 4,14 M 4,10 L 4,3 M 12,21 L 12,12 M 12,8 L 12,3 M 20,21 L 20,16 M 20,12 L 20,3 M 1,14 L 7,14 M 9,8 L 15,8 M 17,16 L 23,16</Geometry>

    <!-- Layers / Apps icon (for Players & Sources) -->
    <Geometry x:Key="IconLayersGeo">M 12,2 L 2,7 L 12,12 L 22,7 Z M 2,12 L 12,17 L 22,12 M 2,17 L 12,22 L 22,17</Geometry>

    <!-- Gear / Settings icon (for System & Startup) -->
    <Geometry x:Key="IconGearGeo">M 12,15 A 3,3 0 1 0 12,9 A 3,3 0 1 0 12,15 M 19.4,15 A 1.65,1.65 0 0 0 19.7,16.8 L 19.8,17 A 2,2 0 0 1 17,19.8 L 16.8,19.7 A 1.65,1.65 0 0 0 15,19.4 A 1.65,1.65 0 0 0 13.9,20.9 L 13.8,21.2 A 2,2 0 0 1 10.2,21.2 L 10.1,20.9 A 1.65,1.65 0 0 0 9,19.4 A 1.65,1.65 0 0 0 7.2,19.7 L 7,19.8 A 2,2 0 0 1 4.2,17 L 4.3,16.8 A 1.65,1.65 0 0 0 4.6,15 A 1.65,1.65 0 0 0 3.1,13.9 L 2.8,13.8 A 2,2 0 0 1 2.8,10.2 L 3.1,10.1 A 1.65,1.65 0 0 0 4.6,9 A 1.65,1.65 0 0 0 4.3,7.2 L 4.2,7 A 2,2 0 0 1 7,4.2 L 7.2,4.3 A 1.65,1.65 0 0 0 9,4.6 A 1.65,1.65 0 0 0 10.1,3.1 L 10.2,2.8 A 2,2 0 0 1 13.8,2.8 L 13.9,3.1 A 1.65,1.65 0 0 0 15,4.6 A 1.65,1.65 0 0 0 16.8,4.3 L 17,4.2 A 2,2 0 0 1 19.8,7 L 19.7,7.2 A 1.65,1.65 0 0 0 19.4,9 A 1.65,1.65 0 0 0 20.9,10.1 L 21.2,10.2 A 2,2 0 0 1 21.2,13.8 L 20.9,13.9 A 1.65,1.65 0 0 0 19.4,15 Z</Geometry>

    <!-- File / Log icon -->
    <Geometry x:Key="IconFileGeo">M 14,2 L 6,2 A 2,2 0 0 0 4,4 L 4,20 A 2,2 0 0 0 6,22 L 18,22 A 2,2 0 0 0 20,20 L 20,8 Z M 14,2 L 14,8 L 20,8 M 8,13 L 16,13 M 8,17 L 13,17</Geometry>

    <!-- Code / Brackets icon (for config.json) -->
    <Geometry x:Key="IconCodeGeo">M 16,18 L 22,12 L 16,6 M 8,6 L 2,12 L 8,18</Geometry>

    <!-- External Link / Shortcut icon -->
    <Geometry x:Key="IconShortcutGeo">M 18,13 L 18,19 A 2,2 0 0 1 16,21 L 5,21 A 2,2 0 0 1 3,19 L 3,8 A 2,2 0 0 1 5,6 L 11,6 M 15,3 L 21,3 L 21,9 M 10,14 L 21,3</Geometry>

    <!-- Music Note icon (Placeholder for album art) -->
    <Geometry x:Key="IconMusicGeo">M 9,18 A 3,3 0 1 1 6,15 L 6,4 L 18,4 L 18,16 A 3,3 0 1 1 15,13 L 15,8 L 6,8</Geometry>

    <!-- Play icon -->
    <Geometry x:Key="IconPlayGeo">M 6,4 L 19,12 L 6,20 Z</Geometry>

    <!-- Check icon -->
    <Geometry x:Key="IconCheckGeo">M 20,6 L 9,17 L 4,12</Geometry>

    <!-- ==================== LIQUID GLASS TOGGLE SWITCH ==================== -->
    <Style x:Key="ModernToggleStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="Margin" Value="0,5,0,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Glass Pill Switch Track (42 x 22) -->
                        <Border x:Name="Track"
                                Grid.Column="0"
                                Width="42"
                                Height="22"
                                CornerRadius="11"
                                Background="{StaticResource GlassControlBgBrush}"
                                BorderBrush="{StaticResource GlassControlBorderBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Canvas Width="42" Height="22" IsHitTestVisible="False">
                                <!-- Knob with soft shadow -->
                                <Border x:Name="Knob"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        Background="{StaticResource KnobBrush}"
                                        Canvas.Left="2"
                                        Canvas.Top="2"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="KnobTransform" X="0" Y="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>
                        </Border>

                        <!-- Label Content -->
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Checked State: Luminous Blurple Track, Knob translated +20px -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="20"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource SmoothEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource SmoothEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BlurpleBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GlassPrimaryBtnBorderBrush}" />
                            <Setter TargetName="Track" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource BlurpleColor}" Opacity="0.45" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- MouseOver Highlight -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GlassControlHoverBgBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GlassControlHoverBorderBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BlurpleHoverBrush}" />
                        </MultiTrigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== LIQUID GLASS PRIMARY BUTTON ==================== -->
    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource GlassPrimaryBtnBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassPrimaryBtnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="{StaticResource BlurpleColor}" Opacity="0.35" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource GlassPrimaryBtnHoverBgBrush}" />
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="{StaticResource BlurpleLightColor}" Opacity="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BlurplePressedBrush}" />
                            <Setter TargetName="Border" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== LIQUID GLASS SECONDARY BUTTON ==================== -->
    <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource GlassControlBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource GlassControlHoverBgBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GlassControlHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#111319" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== LIQUID GLASS COMBOBOX ==================== -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Border x:Name="TemplateRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                SnapsToDevicePixels="true">
            <Border x:Name="SplitBorder"
                    Width="28"
                    HorizontalAlignment="Right"
                    SnapsToDevicePixels="true">
                <!-- Clean Vector Chevron Icon -->
                <Path x:Name="Arrow"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0,0 L 4,4 L 8,0"
                      Stroke="{StaticResource TextSecondaryBrush}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="TemplateRoot" Property="Background" Value="{StaticResource GlassControlHoverBgBrush}" />
                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{StaticResource BlurpleBrush}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{StaticResource BlurpleBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ModernComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="6"
                            Margin="2,1,2,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource GlassControlHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BlurpleBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource GlassControlBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0,28,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource ComboBoxToggleButton}"
                                      Grid.Column="2"
                                      Focusable="false"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" />
                        <ContentPresenter IsHitTestVisible="false"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="true"
                               Grid.ColumnSpan="2"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="false"
                               PopupAnimation="Fade">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="#141720"
                                    BorderBrush="{StaticResource GlassCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,6,0,0"
                                    Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="true"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
